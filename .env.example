# Shopify Partner App credentials
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_SECRET=
SHOPIFY_API_VERSION=2024-07
SHOPIFY_APP_URL=https://api.nightshift.ai

# HMAC / OAuth timing
OAUTH_TIMESTAMP_DRIFT_SECONDS=300

# Postgres 16 (uuid-ossp, pgcrypto, vector extensions required)
# NOTE (2026-07-31 — CONFLICTS.md #20): keep this on `localhost`. This file is
# shared by two run modes — native `shopify app dev` (uvicorn on the host,
# reaching Postgres/Redis via their published ports) and Docker Compose
# (core_api/worker containers, which need the service hostnames `postgres`/
# `redis` instead). `docker/docker-compose.yml`'s `environment:` block on the
# core_api/worker services overrides these four vars with the Docker-internal
# hostnames, so this file can stay correct for native `shopify app dev` and
# Compose still gets the right values, without one run mode breaking the other.
DATABASE_URL=postgresql+asyncpg://nightshift:nightshift_dev_password@localhost:5432/nightshift

# Redis 7 (Celery broker/result backend + SSE pubsub + dedup cache)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Token-at-rest encryption (AES-256-GCM). KMS_KEY_ID names the key management
# reference (AWS KMS / GCP KMS key ARN in production). NIGHTSHIFT_LOCAL_DATA_KEY
# is a base64-encoded 32-byte key used ONLY for local/dev/test envelope
# encryption when no KMS is configured (see app/domain/security.py).
KMS_KEY_ID=
NIGHTSHIFT_LOCAL_DATA_KEY=

# Gemini API key (also historically used for the Sprint 2 embeddings spec —
# reused rather than adding a second, redundant GEMINI_API_KEY variable, see
# CONFLICTS.md #13). REQUIRED in production: Chief Ops AI's Executive
# Briefing is hard-wired to Gemini by default regardless of LLM_PROVIDER —
# see CHIEF_OPS_LLM_PROVIDER below — so this must be set for every real
# deployment, not just when LLM_PROVIDER=GEMINI.
GOOGLE_AI_API_KEY=

# Sprint 2: Gemini model. Defaults to gemini-3.6-flash — gemini-1.5-pro
# (named in the source specs) and gemini-2.5-pro (an earlier substitution)
# are both superseded; 3.6-flash satisfies the Google/XPRIZE hackathon's
# "Gemini 3.5 or newer" requirement (see CONFLICTS.md #12). Optional override.
GEMINI_MODEL_NAME=gemini-3.6-flash

# Google/XPRIZE hackathon: set GCP_PROJECT_ID to route Gemini calls through
# Vertex AI instead of the Gemini Developer API — bills through this
# project's normal Google Cloud Billing account (shared with hosting spend)
# rather than AI Studio's own separate Prepay credit balance. Leave empty to
# keep using GOOGLE_AI_API_KEY above unchanged. Requires Application Default
# Credentials (`gcloud auth application-default login` locally; a service
# account's attached identity in Cloud Run/GCE) — no separate API key.
GCP_PROJECT_ID=
GCP_LOCATION=global

# Cloud Run migration: Cloud Scheduler's shared secret for
# POST /internal/dispatch-nightly-shifts (replaces Celery Beat, which has no
# persistent-process equivalent on Cloud Run). Generate with e.g.
# `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`. Empty by
# default — the endpoint always 401s until this is set.
INTERNAL_DISPATCH_SECRET=

# --- LLM provider -----------------------------------------------------------
# Gemini is the sole supported provider. Governs the per-specialist detection
# agents (Product Quality, Checkout Specialist, Tracking Specialist, Theme
# Guardian) ONLY — see CHIEF_OPS_LLM_PROVIDER below for the separate
# Executive Briefing provider.
LLM_PROVIDER=GEMINI

# --- Chief Ops AI / Executive Briefing provider (productionization phase,
# hackathon Gemini-integration requirement) --------------------------------
# Independent of LLM_PROVIDER above: Chief Ops AI's shift-level Executive
# Briefing synthesis (workers/tasks/shift_report.py) defaults to Gemini
# regardless of which provider the specialist agents use, so every deployed
# Morning Shift Report includes a real, auditable Gemini call over that
# shift's actual findings/evidence/revenue-impact data. Requires
# GOOGLE_AI_API_KEY above. Override only for ops flexibility (e.g. a Gemini
# outage) — see app/infrastructure/llm/factory.py.
CHIEF_OPS_LLM_PROVIDER=GEMINI

# --- LLM cost hardening (2026-07-31) --------------------------------------
# Hard cap on output tokens per LLM call — the biggest lever on per-call cost.
# Raised 1024 -> 4096 (2026-07-31, found during live E2E test — CONFLICTS.md
# #22): a real catalog scan of ~40 findings produced a JSON response that
# didn't fit in 1024 output tokens, got cut off mid-string, and correctly
# tripped the max_tokens hard-failure path into the deterministic fallback.
# 4096 covers a realistic single-shift finding count with headroom.
LLM_MAX_OUTPUT_TOKENS=4096
# Hard daily ceiling on LLM calls (Redis-backed, holds across worker
# restarts) — a safety net so a bug/retry storm/repeated test run can never
# exhaust your API budget in one session. Raised to 200 in Sprint 5 (ADR-040)
# since Chief Ops now synthesizes every shift with 1+ findings and demo days
# trigger many on-demand shifts via the Chaos Panel. Raise further if you're
# intentionally running more than 200 shifts/day of testing.
LLM_MAX_CALLS_PER_DAY=200
# Caps how many inspection findings are sent to the LLM per call, regardless
# of catalog size (bounds input-token growth on large/messy catalogs).
LLM_MAX_FINDINGS_PER_CALL=50

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- Sprint 4 Step 1: Demo Incident Generator ------------------------------
# Gates POST /api/v1/demo/incidents/{scenario_id}, which lets an
# authenticated store deliberately corrupt its own live data on cue for demo
# purposes (e.g. create overlapping stackable discount codes). Defaults to
# false so this is never reachable in production unless explicitly enabled —
# see CONFLICTS.md #33. Set to true only in dev/demo environments.
DEMO_MODE_ENABLED=false

# --- Sprint 4: Nightly scheduler --------------------------------------
# Closes the "no scheduler triggers the pipeline automatically" gap flagged
# since Sprint 2. Requires the `beat` service (docker-compose.yml) to be
# running — a plain worker never reads this on its own. Fans out
# tasks.inspect_catalog to every ACTIVE-SUBSCRIPTION store on this interval
# (Free-tier stores are excluded from automatic nightly dispatch — see
# BILLING_ENABLED below — but can still trigger a shift manually).
# 1440 = genuinely nightly; lower for local testing to watch it fire sooner.
SHIFT_SCHEDULE_ENABLED=true
SHIFT_SCHEDULE_INTERVAL_MINUTES=1440

# --- Billing (productionization phase) -------------------------------------
# Real Shopify Billing API (RecurringApplicationCharge via
# appSubscriptionCreate) monetization — Free ($0, manual shifts only) / Pro
# ($29/mo, continuous nightly monitoring + auto-fixes) / Business ($79/mo,
# not yet functionally differentiated from Pro). Every store gets a FREE
# subscription row automatically at install; no payment is ever required to
# use the Free tier. Set BILLING_ENABLED=false to disable the billing router
# entirely (e.g. for a judge/test account you want fully unlocked without a
# live Shopify charge) — see app/api/v1/billing.py.
BILLING_ENABLED=true
# true = Shopify's `test: true` charge flag (never actually bills the
# merchant — required for development stores, safe default). Set false only
# for a real production store that should be genuinely charged.
SHOPIFY_BILLING_TEST_MODE=true

# --- Error reporting (optional) --------------------------------------------
# Sentry is NOT wired into the codebase by default (no SDK dependency, no
# `sentry_sdk.init()` call) — see deploy/README.md's Observability section
# for how to add it as an explicit, opt-in post-deploy step if you want
# production error tracking. Left blank/unset, NightShift runs exactly as it
# does today (structlog + OpenTelemetry only).
SENTRY_DSN=
